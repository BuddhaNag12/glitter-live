# Copy to scripts/storage.env and fill in. storage.env is git-ignored; never commit it or put these keys in the app.
# Supabase dashboard → Project Settings → Storage → S3 Connection.

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=your-region
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=wallpapers

# Supabase dashboard → Project Settings → API Keys → Secret key (sb_secret_…). Lets the upload script add catalog rows.
SUPABASE_SECRET_KEY=
